# =================================
# CONFIGURACIÓN DEL SERVIDOR
# =================================

# Entorno de ejecución (development, production)
NODE_ENV=development

# Puerto en el que correrá el servidor
PORT=3000

# =================================
# BASE DE DATOS
# =================================

# URI de conexión a MongoDB
# Formato: mongodb://usuario:contraseña@host:puerto/nombre_base_datos
# Ejemplo: mongodb://localhost:27017/f-sri
MONGO_URI=mongodb://localhost:27017/f-sri

# =================================
# SEGURIDAD Y AUTENTICACIÓN
# =================================

# Secreto para firmar tokens JWT (genera una cadena aleatoria segura)
# Puedes usar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Otro medio para generarlo puede ser "openssl rand -hex 64"
JWT_SECRET=tu_secreto_jwt_muy_seguro_aqui

# Clave de encriptación de 32 bytes (64 caracteres hexadecimales) para datos sensibles
# Genera un valor real con: openssl rand -hex 32
# (o: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# NO copies el placeholder de abajo tal cual: src/config/env.config.ts exige
# exactamente 64 caracteres hexadecimales y hace fail-fast al arrancar si no
# lo son. El valor de ejemplo se deja deliberadamente inválido/no-hexadecimal
# para que no pueda pegarse "tal cual" en producción por error.
ENCRYPTION_KEY=<genera-con-openssl-rand-hex-32>

# URL pública base de este servidor (sin path final), usada para construir
# los enlaces de onboarding que se envían al crear una invitación de tenant
# (ver src/routes/admin/invite.ts). En producción debe ser la URL real
# expuesta al cliente, nunca localhost.
PUBLIC_URL=http://localhost:3000

# =================================
# CONFIGURACIÓN DE CORS
# =================================

# Orígenes permitidos para CORS (separados por comas)
# Ejemplo: http://localhost:4200,https://tu-dominio.com
ALLOWED_ORIGINS=http://localhost:4200

# Deshabilitar CORS completamente (true/false) - No recomendado en producción
CORS_DISABLED=false

# =================================
# SERVICIO DE CORREO ELECTRÓNICO (Resend)
# =================================

# API Key de Resend (https://resend.com/api-keys)
# Si no se configura, el envío de emails queda deshabilitado de forma
# controlada (sendInvoiceEmail devuelve { success: false, error: '...' })
# en lugar de fallar el arranque del proceso — el email no es una operación
# crítica para la emisión de comprobantes.
RESEND_API_KEY=re_tu_api_key_aqui

# Remitente verificado en Resend (dominio verificado en tu cuenta)
# Formato: "Nombre <correo@tu-dominio-verificado.com>" o solo el correo
EMAIL_FROM=Facturación <facturacion@tu-dominio-verificado.com>

# =================================
# INTEGRACIÓN CON SRI (ECUADOR)
# =================================

# Ambiente del SRI (1 = Pruebas, 2 = Producción)
SRI_ENVIRONMENT=1

# URL de recepción del SRI - Ambiente de Pruebas
SRI_RECEPCION_URL_PRUEBAS=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl

# URL de recepción del SRI - Ambiente de Producción
SRI_RECEPCION_URL_PRODUCCION=https://cel.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl

# URL de autorización del SRI - Ambiente de Pruebas
SRI_AUTORIZACION_URL_PRUEBAS=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl

# URL de autorización del SRI - Ambiente de Producción
SRI_AUTORIZACION_URL_PRODUCCION=https://cel.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl

# Tarifa de IVA vigente (sin signo de porcentaje) y su código según la tabla 17 del SRI
# 15% -> codigoPorcentaje 4 (vigente desde abril 2024)
IVA=15
CODIGO_PORCENTAJE=4

# =================================
# ALMACENAMIENTO DE PDFs
# =================================

# Proveedor de almacenamiento de PDFs (cloudinary, local, s3, azure)
# Opciones:
# - s3: Amazon S3, bucket privado con URLs de descarga presignadas (default recomendado en producción)
# - cloudinary: Almacena PDFs en Cloudinary (servicio en la nube)
# - local: Almacena PDFs localmente en el servidor (útil para desarrollo sin credenciales de nube)
# - azure: Azure Blob Storage (no implementado aún)
PDF_STORAGE_PROVIDER=s3

# =================================
# AMAZON S3 (Almacenamiento de PDFs — proveedor por defecto)
# =================================
# Solo necesario si PDF_STORAGE_PROVIDER=s3. Estas variables se validan de
# forma perezosa (al construir S3PDFStorage), no al arrancar el proceso, para
# no romper el desarrollo local con PDF_STORAGE_PROVIDER=local ni los tests.
# El bucket debe ser PRIVADO: los RIDE contienen datos tributarios y las
# descargas se sirven vía URLs presignadas de corta duración, nunca URLs
# públicas permanentes.

# Credenciales de AWS con permisos de PutObject/GetObject/DeleteObject sobre el bucket
AWS_ACCESS_KEY_ID=tu_access_key_id
AWS_SECRET_ACCESS_KEY=tu_secret_access_key

# Región de AWS donde vive el bucket
AWS_REGION=us-east-1

# Nombre del bucket S3 (privado) donde se almacenan los PDFs
S3_BUCKET=tu-bucket-de-pdfs

# =================================
# ALMACENAMIENTO LOCAL (alternativa a S3 — solo para desarrollo)
# =================================
# Solo necesario si PDF_STORAGE_PROVIDER=local (o si no se define
# PDF_STORAGE_PROVIDER: es el valor por defecto en src/services/storage/storage.factory.ts
# cuando la variable no está presente). No usar en producción: no es
# escalable y no sobrevive a un redeploy del contenedor.

# Ruta donde se guardarán los PDFs (por defecto: ./storage/pdfs)
PDF_STORAGE_PATH=./storage/pdfs

# URL base para acceder a los PDFs guardados localmente (por defecto: http://localhost:3000/pdfs)
PDF_BASE_URL=http://localhost:3000/pdfs

# =================================
# CLOUDINARY (Almacenamiento de PDFs en la nube — alternativa a S3)
# =================================
# Solo necesario si PDF_STORAGE_PROVIDER=cloudinary
# Obtén tus credenciales en: https://cloudinary.com/console

# Nombre de tu cloud en Cloudinary
CLOUDINARY_CLOUD_NAME=----

# API Key de Cloudinary
CLOUDINARY_API_KEY=------

# API Secret de Cloudinary
CLOUDINARY_API_SECRET=----------

# URL completa de Cloudinary (formato alternativo - opcional)
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://--:----@------

