{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    // La declaración de tipos de `resend` referencia react (React.ReactElement)
    // como soporte opcional para plantillas JSX, aun cuando no se instale react
    // como dependencia. No usamos ese modo (enviamos html/text planos), así que
    // sin skipLibCheck tsc falla al resolver ese tipo dentro de node_modules.
    "skipLibCheck": true,
    "types": ["jest", "node"]
  },
  // admin/ is a separate npm package (its own Vite + React + TS project,
  // config, and tsconfig) — see admin/README-less setup in admin/tsconfig*.json.
  // It must stay out of the backend's typecheck: JSX/DOM types aren't part
  // of this project's `types` (["jest", "node"]), and admin/ has no
  // dependency on this tsconfig at all.
  "exclude": ["node_modules", "dist", "admin"]
}
