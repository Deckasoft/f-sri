{
  "name": "f-sri-admin",
  "version": "1.0.0",
  "description": "Backoffice SPA for F Sri: admin tenant management + public onboarding page",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "prettier --check \"src/**/*.{ts,tsx}\" && eslint .",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx}\" && eslint . --fix"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.5.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
