{
  "name": "f-sri-admin",
  "version": "1.0.0",
  "description": "Backoffice SPA for F Sri: admin tenant management + public onboarding page",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "prettier --check \"src/**/*.{ts,tsx}\"",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "prettier": "^3.5.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
