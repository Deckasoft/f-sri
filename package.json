{
  "name": "f-sri",
  "version": "1.0.0",
  "description": "F Sri - Sistema de facturación electrónica para Ecuador con integración al SRI",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false --runInBand",
    "lint": "prettier --check \"src/**/*.ts\"",
    "lint:fix": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test:ci",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "create-admin": "ts-node scripts/create-admin.ts",
    "seed:identification-types": "ts-node scripts/seed-identification-types.ts"
  },
  "keywords": [
    "facturacion-electronica",
    "sri",
    "ecuador",
    "invoicing",
    "electronic-billing",
    "nodejs",
    "typescript",
    "mongodb",
    "express",
    "f-sri"
  ],
  "author": "F Sri Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deckasoft/f-sri.git"
  },
  "bugs": {
    "url": "https://github.com/Deckasoft/f-sri/issues"
  },
  "homepage": "https://github.com/Deckasoft/f-sri#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.18",
    "@types/puppeteer": "^5.4.7",
    "@xmldom/xmldom": "^0.8.13",
    "axios": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ec-sri-invoice-signer": "^1.8.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsbarcode": "^3.11.6",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.15.0",
    "node-forge": "^1.3.1",
    "puppeteer": "^24.9.0",
    "resend": "^6.18.0",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^3.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.19.43",
    "@types/node-forge": "^1.3.11",
    "@types/supertest": "^2.0.12",
    "eslint-config-prettier": "^10.1.5",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.5.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.0"
  }
}
